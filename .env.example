# Application
# PUBLIC - OPTIONAL (local dev override for FastAPI URL)
VITE_API_URL=http://localhost:5000
# SERVER ONLY - REQUIRED (must be the canonical public application URL in deployed environments for QStash callbacks)
APP_BASE_URL=http://localhost:5173

# Supabase - Frontend Public
# PUBLIC - REQUIRED
VITE_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC - REQUIRED
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase - Server Only
# SERVER ONLY - REQUIRED (for admin capabilities and background workers)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key

# Upstash Redis - Server Only
# SERVER ONLY - REQUIRED (for API rate limiting and entitlements)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# QStash - Server Only
# SERVER ONLY - REQUIRED (for triggering scheduled scans and emails)
QSTASH_TOKEN=your-qstash-token
# SERVER ONLY - REQUIRED (for webhook signature verification)
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
# SERVER ONLY - OPTIONAL
# Override only when using a specific QStash endpoint/region.
QSTASH_URL=

# Resend - Server Only
# SERVER ONLY - REQUIRED for application transactional email
# Used for Contact Us and scheduled security reports.
RESEND_API_KEY=your-resend-api-key

# Cloudflare Turnstile
# PUBLIC - used by authentication CAPTCHA UI
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
